# =================================================================
# adspy — zero-cost configuration
# Every service below has a free tier sufficient for in-house volume.
# =================================================================

# --- Storage ---
# Postgres (host port 5433 — see docker-compose.yml). Self-hosted, free.
DATABASE_URL=postgresql+psycopg://adspy:adspy@localhost:5433/adspy

# --- Meta Ad Library Graph API (free, official) ---
# Create at developers.facebook.com → Apps → Tools → Access Token Tool.
# Scope: ads_read. App can be in dev mode — no review needed.
META_GRAPH_TOKEN=
META_GRAPH_API_VERSION=v21.0

# --- AI providers (all free tier) ---
# Google AI Studio — Gemini 2.5 Pro/Flash. 1,500 req/day. Multimodal.
# Get at: aistudio.google.com → Get API Key
GEMINI_API_KEY=

# Groq — Llama 3.3 70B / Qwen 2.5 72B. ~30 req/min, 14.4K req/day. Fastest free text.
# Get at: console.groq.com/keys
GROQ_API_KEY=

# Cloudflare Workers AI — embeddings + auxiliary inference. 10K neurons/day.
# Get at: dash.cloudflare.com → AI → Workers AI → API tokens
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Ollama (local fallback) — leave default if running on same host.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:14b-instruct
OLLAMA_VISION_MODEL=llama3.2-vision:11b

# Routing preferences
AI_TEXT_PRIMARY=groq           # groq | gemini | ollama | cfwai
AI_VISION_PRIMARY=gemini       # gemini | ollama
AI_EMBEDDING_PRIMARY=local     # local | cfwai
LOCAL_ONLY=false               # true = force Ollama for everything

# --- Object storage (Cloudflare R2: 10 GB free, zero egress) ---
# Get at: dash.cloudflare.com → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adspy-media
R2_ENDPOINT=

# --- Capture-replay (Playwright sessions per platform) ---
# Path where captured cookies + headers per platform live.
SESSION_STORE_DIR=./local-cache/sessions

# --- Scrape limits ---
# Soft cap to prevent runaway runs. Adjust as comfort grows.
SCRAPE_MAX_ITEMS_PER_RUN=2000
SCRAPE_TIMEOUT_SECS=600

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
