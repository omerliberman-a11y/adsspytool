# --- Required ---
# Apify token (https://console.apify.com/account/integrations)
APIFY_TOKEN=

# Postgres connection. Default points at the docker-compose service on host port 5433.
DATABASE_URL=postgresql+psycopg://adspy:adspy@localhost:5433/adspy

# Redis (Celery broker + result backend). Default points at the docker-compose service on host port 6380.
REDIS_URL=redis://localhost:6380/0

# --- AI keys (used in Phase 3 onward — leave blank for now) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Object storage (Phase 3 — Cloudflare R2 by default) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adspy-media
R2_ENDPOINT=

# --- Cost controls ---
# Max dollars per single Apify run. Runner aborts and records a failure above this.
APIFY_MAX_USD_PER_RUN=5.00

# Default Apify timeout per run (seconds)
APIFY_TIMEOUT_SECS=600

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
